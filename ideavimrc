" Rider action list
" https://gist.github.com/zchee/9c78f91cc5ad771c1f5d
" See :actionlist

" Don't use Ex mode, use Q for formatting.
map Q gq

Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
Plug 'preservim/nerdtree'

"" Base Settings
"" ========================================================

let mapleader = " "
set ideajoin
set idearefactormode=keep
set ideastatusicon=gray
set incsearch
set relativenumber 
set scrolloff=5
set showcmd
set showmode
set smartcase
set visualbell

" Clipboard 
set clipboard+=unnamedplus
set clipboard+=ideaput
" set clipboard+=unnamed

"" Enable plugins
"" ========================================================

set commentary
set highlightedyank
set nerdtree
set surround

" Which-key settings
"" ========================================================

set which-key
set notimeout
let g:WhichKey_FontSize     = 12
let g:WhichKey_CommandColor = "#87C9FF"
let g:WhichKey_PrefixColor  = "#E5E3DC"
let g:WhichKey_SortOrder    = "by_key_prefix_first"
let g:WhichKeyDesc_leader   = "<leader> Leader key"

"" Key mappings
"" ========================================================

" Tab navigation
nnoremap <Tab> :tabnext<CR>
nnoremap <S-Tab> :tabprev<CR>

" Line navigation
map H ^
map L $

" Pane navigation
sethandler <C-j> a:vim
sethandler <C-k> a:vim
nnoremap <C-h> <C-w>h
nnoremap <C-l> <C-w>l
nnoremap <C-k> <C-w>k
nnoremap <C-j> <C-w>j

" Jump between methods
nnoremap [[ :action MethodUp<CR>
nnoremap ]] :action MethodDown<CR>

" Easy visual indentation
vnoremap < <gv
vnoremap > >gv

" Execute macro saved in 'q' register
nnoremap qj @q

" Save all shortcut
let g:WhichKeyDesc_comma              = ",, Comma commands"
nnoremap ,, :action SaveAll<CR> 

" Hide all windows
nnoremap <c-x> :action HideAllWindows<CR>

" Jump to last window 
nnoremap <c-p> :action JumpToLastWindow<CR>

" LSP shortcuts
nmap gh :action ShowHoverInfo<CR>
nmap gd :action ReSharperGotoImplementation<CR>
nmap gD :action GotoTypeDeclaration<CR>

"" Leader commands
"" ========================================================

" Format code 
let g:WhichKeyDesc_format_code                      = "<leader>f Format code"
map <leader>f :action ReformatCode<CR>

" Recent files
let g:WhichKeyDesc_file_show_quickLook              = "<leader><leader> Recent files"
map <leader><leader> :action RecentFiles<CR>

" Comment lines
let g:WhichKeyDesc_comment                          = "<leader>c Comment line"
map <leader>c :action CommentByLineComment<CR>

" LSP 
let g:WhichKeyDesc_show_hover_info                  = "<leader>i Show hover info"
nmap <leader>i  :action ShowHoverInfo<CR>

" Close active tab
let g:WhichKeyDesc_close_tab                        = "<leader>q Close active tab"
map <leader>q :action CloseContent<CR>

" Actions
let g:WhichKeyDesc_action                           = "<leader>a Actions"
let g:WhichKeyDesc_action_edit_ideavimrc            = "<leader>ae Edit vim config"
let g:WhichKeyDesc_action_reload_ideavimrc          = "<leader>ar Reload vim config"
let g:WhichKeyDesc_action_list                      = "<leader>al Show action list"
let g:WhichKeyDesc_action_show_intention_actions    = "<leader>as Show intention actions"
let g:WhichKeyDesc_action_search_search_everywhere  = "<leader>as Search everywhere"
map <leader>ae :e ~/.ideavimrc<CR>
map <leader>ar :action IdeaVim.ReloadVimRc.reload<CR>
map <leader>al :actionlist<CR>
map <leader>am :action ShowIntentionActions<CR>
map <leader>as :action SearchEverywhere<CR>

" Errors
let g:WhichKeyDesc_errors                          = "<leader>e Errors"
let g:WhichKeyDesc_errors_next                     = "<leader>ej Go to next error"
let g:WhichKeyDesc_errors_prev                     = "<leader>ek Go to previous error"
let g:WhichKeyDesc_errors_next_solution            = "<leader>en Go to next error in solution"
let g:WhichKeyDesc_errors_prev_solution            = "<leader>ep Go to previous error in solution"
map <leader>ej :action GotoNextError<CR>
map <leader>ek :action GotoPreviousError<CR>
map <leader>en :action ReSharperGotoNextErrorInSolution<CR>
map <leader>ep :action ReSharperGotoPrevErrorInSolution<CR>

"" Git, Goto, Info
let g:WhichKeyDesc_g                               = "<leader>g Git / GoTo"

"" Git
let g:WhichKeyDesc_g_commit                        = "<leader>gc Open Git commit dialog"
let g:WhichKeyDesc_g_status                        = "<leader>gs Open Git status dialog"
let g:WhichKeyDesc_g_branches                      = "<leader>gb Open Git branches list"
map <leader>gc :action CheckinProject<CR>
map <leader>gs :action ActivateVersionControlToolWindow<CR>
map <leader>gb :action Git.Branches<CR>

"" Goto
let g:WhichKeyDesc_g_implementation                = "<leader>gd Go to Implementation"
let g:WhichKeyDesc_g_declaration                   = "<leader>gD Go to Declaration"
let g:WhichKeyDesc_g_type_declaration              = "<leader>gy Go to Type Definition"
let g:WhichKeyDesc_g_usages                        = "<leader>gu Go to Usages"
