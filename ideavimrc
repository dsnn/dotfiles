" IdeaVim configuration for JetBrains Rider.
" Find action IDs with "IdeaVim: Track Action IDs" or :actionlist.
" IDE actions use <Action>(...) as recommended by IdeaVim.

let mapleader = " "

" Plugins
" ========================================================

Plug 'machakann/vim-highlightedyank'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-surround'
Plug 'preservim/nerdtree'

" Base settings
" ========================================================

set ideajoin
set idearefactormode=keep
set ideastatusicon=gray

set hlsearch
set ignorecase
set incsearch
set number
set relativenumber
set scrolloff=5
set showcmd
set showmode
set smartcase
set visualbell

set clipboard+=unnamedplus
set clipboard+=ideaput

" Which-key
" ========================================================

set which-key
set notimeout
let g:WhichKey_FontSize     = 12
let g:WhichKey_CommandColor = "#89B4FA"
let g:WhichKey_PrefixColor  = "#CBA6F7"
let g:WhichKey_SortOrder    = "by_key_prefix_first"
let g:WhichKeyDesc_leader   = "<leader> Leader key"

" Vim navigation and editing
" ========================================================

" Don't use Ex mode; use Q for formatting.
nnoremap Q gq

" Jump to the first non-blank character or end of the line.
nnoremap H ^
nnoremap L $
xnoremap H ^
xnoremap L $

" Editor tab navigation.
nnoremap <Tab> :tabnext<CR>
nnoremap <S-Tab> :tabprev<CR>

" Pane navigation. Keep these shortcuts in IdeaVim, not the IDE keymap.
sethandler <C-h> a:vim
sethandler <C-j> a:vim
sethandler <C-k> a:vim
sethandler <C-l> a:vim
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Jump between methods.
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

" Keep visual selection while indenting.
xnoremap < <gv
xnoremap > >gv

" Execute the macro saved in register q.
nnoremap qj @q

" Diagnostics and VCS changes.
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
nmap [c <Action>(VcsShowPrevChangeMarker)
nmap ]c <Action>(VcsShowNextChangeMarker)

" LSP-style navigation, aligned with the Neovim mappings.
nmap gh <Action>(ShowHoverInfo)
nmap gd <Action>(ReSharperGotoImplementation)
nmap gD <Action>(FindUsages)
nmap gi <Action>(GotoDeclaration)
nmap gt <Action>(GotoTypeDeclaration)

" IDE shortcuts
" ========================================================

let g:WhichKeyDesc_save_all = ",, Save all"
nmap ,, <Action>(SaveAll)

nmap <C-x> <Action>(HideAllWindows)
nmap <C-p> <Action>(JumpToLastWindow)

" Leader commands
" ========================================================

let g:WhichKeyDesc_code_actions = "<leader>. Show intention actions"
nmap <leader>. <Action>(ShowIntentionActions)

let g:WhichKeyDesc_clear_search = "<leader>/ Clear search highlight"
nnoremap <leader>/ :nohlsearch<CR>

let g:WhichKeyDesc_format_code = "<leader>f Format code"
nmap <leader>f <Action>(ReformatCode)
xmap <leader>f <Action>(ReformatCode)

let g:WhichKeyDesc_recent_files = "<leader><leader> Recent files"
nmap <leader><leader> <Action>(RecentFiles)

let g:WhichKeyDesc_comment = "<leader>c Comment line or selection"
nmap <leader>c <Action>(CommentByLineComment)
xmap <leader>c <Action>(CommentByLineComment)

let g:WhichKeyDesc_hover = "<leader>i Show hover info"
nmap <leader>i <Action>(ShowHoverInfo)

let g:WhichKeyDesc_project = "<leader>p Project tool window"
nmap <leader>p <Action>(ActivateProjectToolWindow)

let g:WhichKeyDesc_close_tab = "<leader>q Close active tab"
nmap <leader>q <Action>(CloseContent)

