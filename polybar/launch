#!/usr/bin/env bash

killall -q polybar

while pgrep -x polybar >/dev/null; do
  sleep 0.1
done

# Get monitors safely
mapfile -t MONITORS < <(xrandr --query | grep " connected" | cut -d" " -f1)

# Fallback if empty
if [ ${#MONITORS[@]} -eq 0 ]; then
  MONITORS=("default")
fi

# Launch polybar per monitor
for m in "${MONITORS[@]}"; do
  MONITOR="$m" polybar mybar >/dev/null 2>&1 &
done
