#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"
skills_dir="$repo_dir/ai/skills"
project_catalog="$repo_dir/ai/project-skills.json"
failed=0
count=0

manual_skills=(grill-me grill-with-docs improve-codebase-architecture to-spec plan-tasks to-questionnaire triage wayfinder implement implement-spec setup-pre-commit handoff retro wizard teach wait-what setup-project improve-skill list-skills update-skills which-skill)
automatic_skills=(code-review codebase-design diagnosing-bugs domain-modeling grilling pr prototype research tdd validate-dotfiles writing-for-agents)
required_skills=("${manual_skills[@]}" "${automatic_skills[@]}")

for dir in "$skills_dir"/*; do
  [[ -d "$dir" ]] || continue
  count=$((count + 1))
  name="$(basename "$dir")"
  manifest="$dir/SKILL.md"
  metadata="$dir/agents/openai.yaml"
  if [[ ! -f "$manifest" || ! -f "$metadata" ]]; then
    printf 'error: %s is missing SKILL.md or agents/openai.yaml\n' "$name" >&2
    failed=1
    continue
  fi
  manifest_name="$(sed -nE 's/^name: ([a-z0-9-]+)$/\1/p' "$manifest" | head -n 1)"
  if [[ "$manifest_name" != "$name" ]]; then
    printf 'error: skill directory/name mismatch: %s != %s\n' "$name" "$manifest_name" >&2
    failed=1
  fi
  if rg -n '\[TODO|TODO:|Briefly describe|Help with .* tasks' "$dir"; then
    printf 'error: unfinished scaffold content in %s\n' "$name" >&2
    failed=1
  fi
  if ! yq eval '.' "$metadata" >/dev/null; then
    printf 'error: invalid metadata YAML: %s\n' "$metadata" >&2
    failed=1
  fi
done

for name in "${required_skills[@]}"; do
  [[ -d "$skills_dir/$name" ]] || { printf 'error: required skill is missing: %s\n' "$name" >&2; failed=1; }
done

for name in "${manual_skills[@]}"; do
  value="$(yq eval '.policy.allow_implicit_invocation' "$skills_dir/$name/agents/openai.yaml")"
  [[ "$value" == false ]] || { printf 'error: %s must require explicit invocation\n' "$name" >&2; failed=1; }
done

for name in "${automatic_skills[@]}"; do
  value="$(yq eval '.policy.allow_implicit_invocation' "$skills_dir/$name/agents/openai.yaml")"
  [[ "$value" != false ]] || { printf 'error: %s must allow automatic selection\n' "$name" >&2; failed=1; }
done

if ! jq -e '
  .schema == 1 and
  (.dependencies | type == "object") and
  (.excluded | type == "object") and
  all(.dependencies[]; (.required | type == "array") and (.optional | type == "array"))
' "$project_catalog" >/dev/null; then
  printf 'error: invalid project skill catalog: %s\n' "$project_catalog" >&2
  failed=1
else
  while IFS=$'\t' read -r owner dependency kind; do
    if [[ ! "$owner" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ || ! -d "$skills_dir/$owner" ]]; then
      printf 'error: project skill catalog has unknown owner: %s\n' "$owner" >&2
      failed=1
    fi
    if [[ ! "$dependency" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ || ! -d "$skills_dir/$dependency" ]]; then
      printf 'error: project skill catalog has unknown %s dependency: %s -> %s\n' "$kind" "$owner" "$dependency" >&2
      failed=1
    fi
    if jq -e --arg name "$dependency" '.excluded[$name] != null' "$project_catalog" >/dev/null; then
      printf 'error: project skill dependency is excluded from copying: %s -> %s\n' "$owner" "$dependency" >&2
      failed=1
    fi
  done < <(jq -r '
    .dependencies | to_entries[] as $entry |
    ($entry.value.required[]? | [$entry.key, ., "required"] | @tsv),
    ($entry.value.optional[]? | [$entry.key, ., "optional"] | @tsv)
  ' "$project_catalog")
  while IFS= read -r name; do
    if [[ ! "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ || ! -d "$skills_dir/$name" ]]; then
      printf 'error: project skill catalog excludes an unknown skill: %s\n' "$name" >&2
      failed=1
    fi
    if jq -e --arg name "$name" '.dependencies[$name] != null' "$project_catalog" >/dev/null; then
      printf 'error: project skill catalog both configures and excludes: %s\n' "$name" >&2
      failed=1
    fi
  done < <(jq -r '.excluded | keys[]' "$project_catalog")
fi

for file in "$repo_dir/ai/project-template/base.md" \
  "$repo_dir/ai/project-template/extensions/dotnet.md" \
  "$repo_dir/ai/project-template/extensions/azure-functions.md" \
  "$repo_dir/ai/project-template/extensions/avalonia.md"; do
  [[ -s "$file" ]] || { printf 'error: missing project template: %s\n' "$file" >&2; failed=1; }
done

bash -n "$repo_dir/scripts/ai-project" "$repo_dir/scripts/ai-skills" "$repo_dir/scripts/validate-ai-toolkit" || failed=1

if (( failed )); then
  exit 1
fi
printf '✓ AI toolkit structure valid (%s discovered skills)\n' "$count"
