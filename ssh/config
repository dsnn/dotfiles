Include ~/.colima/ssh_config

Include ~/.ssh/private/*

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

Host *
  AddKeysToAgent yes
  ControlMaster auto
  ControlPath ~/.ssh/controlmasters/%C
  ControlPersist 10m
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes
