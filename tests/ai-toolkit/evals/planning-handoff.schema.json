{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "decisions", "acceptance_criteria", "tasks", "handoff"],
  "properties": {
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "requirement_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ids", "decision_ids", "acceptance_criterion_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "requirement_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "decision_ids": { "type": "array", "items": { "type": "string" } },
          "acceptance_criterion_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_ids", "decision_ids", "task_ids", "acceptance_criterion_ids", "verification", "mutation_authorized"],
      "properties": {
        "requirement_ids": { "type": "array", "items": { "type": "string" } },
        "decision_ids": { "type": "array", "items": { "type": "string" } },
        "task_ids": { "type": "array", "items": { "type": "string" } },
        "acceptance_criterion_ids": { "type": "array", "items": { "type": "string" } },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["acceptance_criterion_id", "status"],
            "properties": {
              "acceptance_criterion_id": { "type": "string" },
              "status": { "type": "string", "enum": ["passed", "failed", "not_run"] }
            }
          }
        },
        "mutation_authorized": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
