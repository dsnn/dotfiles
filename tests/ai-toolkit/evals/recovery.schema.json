{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "reconstruct_from_git", "trust_agent_reports", "automatic_retry", "cleanup_authorized", "integration_continues", "safe_stop", "handoff_required", "stop_reasons"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "action", "evidence_verified"],
        "properties": {
          "id": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
          "state": { "type": "string", "enum": ["ready", "active", "partial", "failed", "integrated", "blocked"] },
          "action": { "type": "string", "enum": ["inspect", "preserve", "integrate", "retry", "cleanup", "stop", "resolve_after_approval"] },
          "evidence_verified": { "type": "boolean" }
        }
      }
    },
    "reconstruct_from_git": { "type": "boolean" },
    "trust_agent_reports": { "type": "boolean" },
    "automatic_retry": { "type": "boolean" },
    "cleanup_authorized": { "type": "boolean" },
    "integration_continues": { "type": "boolean" },
    "safe_stop": { "type": "boolean" },
    "handoff_required": { "type": "boolean" },
    "stop_reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
