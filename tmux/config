set -g default-terminal "tmux-256color"
set -s terminal-features[100] "xterm-256color:RGB"

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

set -g status-keys vi
set -g mode-keys vi

unbind C-b
set -g prefix C-a
bind C-a send-prefix

set -g mouse on
set -g focus-events on
set -g clock-mode-style 24
set -s escape-time 0
set -s set-clipboard on
set -g history-limit 100000

# ============================================= #
# Catppuccin
# ============================================= #

set -g @plugin 'catppuccin/tmux'
set -g @catppuccin_flavor 'mocha'
set -g @catppuccin_window_status_style 'rounded'

# ============================================= #
# Tilish
# ============================================= #

set -g @plugin 'jabirali/tmux-tilish'
set -g @tilish-navigator 'on'

# ============================================= #
# vim-tmux-navigator
# ============================================= #

set -g @plugin 'christoomey/vim-tmux-navigator'

# ============================================= #
# UI tweaks
# ============================================= #

set -g status-interval 5
set -g status-justify left
set -g status-position top
set -g status-left-length 100
set -g status-right-length 100
set -g status-left ""
set -g status-right "#{E:@catppuccin_status_application}"
set -ag status-right "#{E:@catppuccin_status_session}"

set -g detach-on-destroy off

setw -g monitor-activity off
set -g visual-activity off

set -g allow-rename off

# ============================================= #
# binds
# ============================================= #

bind -N "lazygit popup" g display-popup -w "80%" -h "80%" -d "#{pane_current_path}" -E "lazygit"

bind -N "reload tmux config" r source-file ~/.config/tmux/tmux.conf \; display-message "Config reloaded"

bind -N "toggle synchronized panes" -n C-M-y setw synchronize-panes

bind -N "new window in current directory" c new-window -c "#{pane_current_path}"
bind -N "split pane vertically" h split-window -c "#{pane_current_path}"
bind -N "split pane horizontally" v split-window -h -c "#{pane_current_path}"
bind -N "kill active pane" x kill-pane

bind -N "enter copy mode" -n C-M-u copy-mode
bind -N "paste tmux buffer" -n C-M-p paste-buffer

bind -N "begin copy selection" -T copy-mode-vi v send-keys -X begin-selection
bind -N "copy selection" -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -N "toggle rectangular selection" -T copy-mode-vi r send-keys -X rectangle-toggle

bind -N "last-session (via sesh)" L run-shell "sesh last"

bind -N "sesh session picker" s run-shell "sesh connect \"$(
  sesh list --icons | fzf --tmux 80%,70% \
    --no-sort \
    --ansi \
    --border-label ' sesh ' \
    --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^d tmux kill ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list --icons -t)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list --icons -c)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list --icons -z)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {}'
)\""

bind -N "search zsh aliases and tmux keys" ? display-popup \
  -w "80%" -h "70%" -d "#{pane_current_path}" \
  -E "FZF_HELP_HEIGHT=100% zsh -ic fzf-help"

set -g @plugin 'tmux-plugins/tpm'
run-shell '"${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/tpm/tpm"'
