set -g default-terminal "xterm-256color"

set -g base-index 1
setw -g pane-base-index 1

set -g default-shell "/bin/zsh"

set -g status-keys vi
set -g mode-keys vi

unbind C-b
set -g prefix C-a
bind C-a send-prefix

set -g mouse on
set -g focus-events off
setw -g aggressive-resize on
set -g clock-mode-style 24
set -s escape-time 0
set -g history-limit 1000000

# ============================================= #
# Catppuccin
# ============================================= #

set -g @plugin 'catppuccin/tmux'
set -g @catppuccin_flavour 'mocha'
set -g @catppuccin_window_tabs_enabled on
set -g @catppuccin_status_modules_right "application session"

# ============================================= #
# Tilish
# ============================================= #

set -g @plugin 'jabirali/tmux-tilish'
set -g @tilish-navigator 'on'

# ============================================= #
# vim-tmux-navigator
# ============================================= #

set -g @plugin 'christoomey/vim-tmux-navigator'

# ============================================= #
# UI tweaks
# ============================================= #

set -g status-interval 0
set -g status-justify left
set -g status-position top

set -ga terminal-overrides ',*:Tc'
set -ga terminal-overrides '*:Ss=\E[%p1%d q:Se=\E[ q'

set -g detach-on-destroy off

setw -g monitor-activity off
set -g visual-activity off

set -g allow-rename off

# ============================================= #
# binds
# ============================================= #

bind g display-popup -w "80%" -h "80%" -d "#{pane_current_path}" -E "lazygit"

bind r source-file ~/.config/tmux/tmux.conf \; display-message "Config reloaded"

bind -n C-M-y setw synchronize-panes

bind c new-window -c "#{pane_current_path}"
bind h split-window -c "#{pane_current_path}"
bind v split-window -h -c "#{pane_current_path}"
bind x kill-pane

bind -n C-M-u copy-mode
bind -n C-M-p paste-buffer

bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi r send-keys -X rectangle-toggle

bind -N "last-session (via sesh)" L run-shell "sesh last"

# sesh fzf tmux
bind-key K run-shell "sesh connect \"$(
  sesh list --icons --hide-duplicates | fzf-tmux -p 100%,100% --no-border \
    --ansi \
    --no-sort \
    --prompt '⚡  ' \
    --color 'list-border:6,input-border:3,preview-border:4,header-bg:-1,header-border:6' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-b:abort' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
    --preview-window 'right:70%' \
    --preview 'sesh preview {}'
)\""

bind-key s run-shell "sesh connect \"$(
  sesh list --icons | fzf --tmux 80%,70% \
    --no-sort \
    --ansi \
    --border-label ' sesh ' \
    --prompt '⚡  ' \
    --header '  ^a all ^t tmux ^g configs ^x zoxide ^d tmux kill ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list --icons -t)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list --icons -c)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list --icons -z)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {}'
)\""

set -g @plugin 'tmux-plugins/tpm'
run '~/.config/tmux/plugins/tpm/tpm'
