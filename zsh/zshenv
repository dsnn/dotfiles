# Keep this file quiet and lightweight: .zshenv is read by every Zsh process.
export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"
export LESS="${LESS:--FRSXM}"
export LESSCHARSET="${LESSCHARSET:-utf-8}"
export LEDGER_COLOR="${LEDGER_COLOR:-true}"

# Make Homebrew discoverable before .zprofile can run `brew shellenv`.
typeset -U path PATH
for brew_prefix in /opt/homebrew /home/linuxbrew/.linuxbrew; do
  if [[ -d "$brew_prefix/bin" ]]; then
    path=("$brew_prefix/bin" "$brew_prefix/sbin" $path)
  fi
done
unset brew_prefix
