day() {
  local author
  author="$(git config --get user.name)" || return
  git log --reverse --no-merges --branches --date=iso --since=midnight --author="$author" "$@"
}

delete-merged-branches() {
  local base="${1:-}"
  local branch
  local -a branches

  if [[ -z "$base" ]]; then
    base="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
    base="${base#origin/}"
  fi
  [[ -n "$base" ]] || base="$(git config --get init.defaultBranch)"
  [[ -n "$base" ]] || base=main

  if ! git rev-parse --verify --quiet "$base^{commit}" >/dev/null; then
    print -u2 -- "base branch not found: $base"
    return 1
  fi

  branches=("${(@f)$(git for-each-ref --format='%(refname:short)' --merged "$base" refs/heads/)}")
  for branch in "${branches[@]}"; do
    [[ -n "$branch" && "$branch" != "$base" ]] && git branch -d -- "$branch"
  done
}

s() {
  if ! (( $+commands[sesh] && $+commands[fzf] )); then
    print -u2 'sesh and fzf are required'
    return 127
  fi

  local session
  session="$(sesh list --icons | fzf --ansi)"
  [[ -n "$session" ]] && sesh connect "$session"
}

