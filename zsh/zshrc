ex() {
  if (( $# != 1 )); then
    print -u2 'usage: ex <archive>'
    return 2
  fi

  local archive="$1"
  if [[ ! -f "$archive" ]]; then
    print -u2 -- "'$archive' is not a valid file"
    return 1
  fi

  case "$archive" in
    (*.tar.bz2|*.tbz2) tar xjf "$archive" ;;
    (*.tar.gz|*.tgz)   tar xzf "$archive" ;;
    (*.tar.xz)         tar xJf "$archive" ;;
    (*.tar.zst)        tar --zstd -xf "$archive" ;;
    (*.bz2)            bunzip2 "$archive" ;;
    (*.rar)            unrar x "$archive" ;;
    (*.gz)             gunzip "$archive" ;;
    (*.tar)            tar xf "$archive" ;;
    (*.zip)            unzip "$archive" ;;
    (*.Z)              uncompress "$archive" ;;
    (*.7z)             7z x "$archive" ;;
    (*)
      print -u2 -- "'$archive' cannot be extracted by ex"
      return 1
      ;;
  esac
}

